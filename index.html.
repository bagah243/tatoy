import tkinter as tk

import random

root = tk.Tk()

root.title("WINDOWS FATAL ERROR")

root.attributes("-fullscreen", True)

root.configure(bg="black")

title = tk.Label(

    root,

    text="⚠ SYSTEM FAILURE ⚠",

    fg="red",

    bg="black",

    font=("Consolas", 38, "bold")

)

title.pack(pady=40)

status = tk.Label(

    root,

    text="Инициализация...",

    fg="lime",

    bg="black",

    font=("Consolas", 20)

)

status.pack(pady=20)

log = tk.Label(

    root,

    text="",

    fg="red",

    bg="black",

    font=("Consolas", 14),

    justify="left"

)

log.pack(pady=20)

progress = 0

def update():

    global progress

    progress = min(progress + random.randint(1, 5), 100)

    status.config(

        text=f"КРИТИЧЕСКИЙ СБОЙ WINDOWS: {progress}%"

    )

    log.config(

        text="\n".join(

            random.sample([

                "ERROR: SYSTEM FAILURE",

                "WARNING: UNKNOWN PROCESS",

                "ERROR: MEMORY CORRUPTED",

                "SYSTEM FILE CHECK FAILED",

                "CRITICAL EXCEPTION 0x000000",

                "FAKE WINDOWS DELETION..."

            ], 4)

        )

    )

    if progress < 100:

        root.after(500, update)

    else:

        status.config(text="наипал")

root.bind("<Escape>", lambda e: root.destroy())

update()

root.mainloop()
